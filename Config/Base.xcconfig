// Shared build settings for Share you (iOS).
// Values that differ per environment live in Debug.xcconfig / Release.xcconfig.
// Secret / account-specific values go in Secrets.xcconfig (git-ignored). See Secrets.example.xcconfig.

PRODUCT_NAME = ShareYou
PRODUCT_BUNDLE_IDENTIFIER = com.ol.your.mob.send.share.files
APP_DISPLAY_NAME = Share you

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 5.0
SDKROOT = iphoneos
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

INFOPLIST_FILE = Config/Info.plist
CODE_SIGN_ENTITLEMENTS = Config/ShareYou.entitlements
CODE_SIGN_STYLE = Automatic
// Set your Apple Team ID in Secrets.xcconfig (DEVELOPMENT_TEAM = ABCDE12345).
DEVELOPMENT_TEAM =

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES
// Crashlytics' upload script reads files outside the sandbox.
ENABLE_USER_SCRIPT_SANDBOXING = NO
// Crashlytics needs dSYMs in every configuration.
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
OTHER_LDFLAGS = $(inherited) -ObjC

// ---- Google Sign-In (from GoogleService-Info.plist: CLIENT_ID / REVERSED_CLIENT_ID)
GOOGLE_CLIENT_ID = 14039161405-ub3mhts6m1mee350glmocrtg4a3gc07q.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.14039161405-ub3mhts6m1mee350glmocrtg4a3gc07q

// ---- App links shown in Settings / About
// "//" starts a comment in xcconfig, so URLs are written as https:/$()/...
PRIVACY_POLICY_URL = https:/$()/sites.google.com/view/occessstudiollc/privacy-policy
TERMS_URL = https:/$()/www.apple.com/legal/internet-services/itunes/dev/stdeula/
SUPPORT_EMAIL = hello@theoccess.com
// Numeric App Store id (App Store Connect › App Information › Apple ID). Used for Rate / Share links.
// Set in Secrets.xcconfig after the app is created in App Store Connect.
APP_STORE_ID = 0000000000
// Developer page for "More apps" — OCCESS STUDIO LLC App Store
MORE_APPS_URL = https:/$()/apps.apple.com/us/developer/occess-studio-llc/id1767799636

// ---- Adjust (attribution)
ADJUST_APP_TOKEN = 3xsqwfivifi8
ADJUST_EVENT_START_TRIAL = 8vleqp
ADJUST_EVENT_AD_REVENUE = h09t4e

// Account-specific overrides (Team ID, real AdMob ids). Optional, git-ignored.
#include? "Secrets.xcconfig"
