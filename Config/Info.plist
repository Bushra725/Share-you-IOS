	<key>GIDClientID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-signin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>shareyou</string>
			</array>
		</dict>
	</array>

	<!-- "Open in / Copy to Share you" from any app (Android's share-to) -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Any file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.item</string>
				<string>public.content</string>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<!-- Received files show in the Files app: On My iPhone › Share you -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- Local network: offline transfer, nearby discovery, Connect to PC -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Share you finds nearby phones and computers on your Wi-Fi or hotspot so you can send and receive files directly, without the internet.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_zapshare._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Permission strings (asked only when the feature is used) -->
	<key>NSCameraUsageDescription</key>
	<string>The camera scans the QR code shown on the other device so the two can connect.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Share you shows your photos and videos so you can play them, hide them in Safebox or clean up duplicates.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Share you saves received and converted photos and videos to your library.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Share you plays songs stored on this iPhone in its music player. Nothing is uploaded.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID unlocks your Safebox.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>This lets us show ads that are more relevant to you. You can say no and the app works the same. Premium removes all ads.</string>

